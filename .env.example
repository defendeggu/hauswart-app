# Supabase-Projekteinstellungen (öffentlich, siehe docs/PLAN.md). Bei neuen
# Supabase-Projekten heisst VITE_SUPABASE_ANON_KEY auch "publishable key".
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Basis-Pfad für den Build. Für GitHub Pages unter /hauswart-app/, für eine
# eigene Domain später "/". Siehe docs/PLAN.md Abschnitt 10.
VITE_BASE_PATH=/hauswart-app/
